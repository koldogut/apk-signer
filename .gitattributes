# Normalizacion de fin de linea. El repo tenia app.py y static/js/app.js con
# CRLF y LF mezclados, lo que generaba diffs con ruido en cada edicion.
* text=auto

# Ficheros que se ejecutan en Linux: siempre LF.
*.sh    text eol=lf
*.py    text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.timer   text eol=lf
Dockerfile text eol=lf

# Binarios
*.png   binary
*.jks   binary
*.jar   binary
